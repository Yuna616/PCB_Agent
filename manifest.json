{
  "manifest_version": 3,
  "name": "PCB 에이전트",
  "version": "2.0.0",
  "description": "프로젝트 문서를 업로드하면 AI가 EasyEDA 원리도 작업을 어떻게 진행할지 채팅으로 안내합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://easyeda.com/*",
    "https://*.easyeda.com/*",
    "https://pro.easyeda.com/*",
    "https://oshwlab.com/*",
    "https://*.oshwlab.com/*",
    "https://lceda.cn/*",
    "https://*.lceda.cn/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://easyeda.com/*",
        "https://*.easyeda.com/*",
        "https://oshwlab.com/*",
        "https://*.oshwlab.com/*",
        "https://lceda.cn/*",
        "https://*.lceda.cn/*"
      ],
      "js": ["easyeda-reader.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://easyeda.com/*",
        "https://*.easyeda.com/*",
        "https://oshwlab.com/*",
        "https://*.oshwlab.com/*",
        "https://lceda.cn/*",
        "https://*.lceda.cn/*"
      ],
      "js": [
        "messageBridge.js",
        "contentScript.js"
      ],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
